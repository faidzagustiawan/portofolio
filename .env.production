# Committed on purpose. Every value here is already inlined into the JavaScript
# bundle and served to each visitor, so keeping it in the repo exposes nothing
# that a browser's view-source would not — and it stops the build from silently
# losing configuration in CI, where the gitignored .env does not exist.
#
# Real secrets (R2 access keys, ADMIN_PASSWORD) stay in .env, which is ignored.
# Nothing without a VITE_ prefix belongs in this file.

VITE_SITE_URL="https://faidzagustiawan.id"
VITE_PB_URL="https://faidz.fun/pb"

# EmailJS. The public key is designed to be exposed; restrict the allowed
# origins in the EmailJS dashboard, which is the control that actually matters.
VITE_EMAILJS_SERVICE_ID="service_gn4iko8"
VITE_EMAILJS_TEMPLATE_OWNER="template_0s4xa5r"
VITE_EMAILJS_TEMPLATE_AUTOREPLY="template_onqzfb3"
VITE_EMAILJS_PUBLIC_KEY="iItwsyPtsQCulJJHD"
