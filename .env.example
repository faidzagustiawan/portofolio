# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Cloudflare R2 (server-side only, used by `pnpm r2:sync`)
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="your_bucket_name"

# ---------------------------------------------------------------------------
# Public config. Anything prefixed VITE_ is inlined into the client bundle and
# is therefore visible to every visitor. Never put a secret behind this prefix.
# ---------------------------------------------------------------------------

# R2 public base URL, no trailing slash
VITE_R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"

# PocketBase REST base, no trailing slash
VITE_PB_URL="https://faidz.fun/pb"

# EmailJS. The public key is designed to be exposed, but restrict the allowed
# origins in the EmailJS dashboard or the form can be driven from any domain.
VITE_EMAILJS_SERVICE_ID="service_xxxxxxx"
VITE_EMAILJS_TEMPLATE_OWNER="template_xxxxxxx"
VITE_EMAILJS_TEMPLATE_AUTOREPLY="template_xxxxxxx"
VITE_EMAILJS_PUBLIC_KEY="xxxxxxxxxxxxxxxx"

# Canonical origin used for SEO tags and the generated sitemap
VITE_SITE_URL="https://faidzagustiawan.com"
