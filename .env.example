# Konfigurasi Cloudflare R2
# Dapatkan kredensial ini dari Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="your_bucket_name"

# R2 Public URL (Gunakan custom domain atau R2.dev URL, pastikan tanpa garis miring di akhir)
# Ini akan digunakan di Frontend (oleh Vite) dan harus diawali dengan VITE_
VITE_R2_PUBLIC_URL="https://pub-xxxxx.r2.dev"
